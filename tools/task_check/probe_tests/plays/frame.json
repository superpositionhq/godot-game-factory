    {"id": "drawn", "kind": "render", "fields": ["draw_calls", "texture_mb", "triangles"]},
    {"id": "bright", "kind": "screen", "rect": [0.0, 0.0, 1.0, 1.0]},
    {"id": "button", "kind": "widgets", "select": {"name": "TapButton"}, "fields": ["h", "w", "x", "y"]},
    {"id": "cam", "kind": "camera", "fields": ["occluded", "player_on_screen"]}
  ]
