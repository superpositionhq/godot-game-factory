    {"t": 1.1, "key": "<Keyboard>/space", "press": false},
    {"t": 2.0, "shot": "late", "when": {"query": {"id": "w_late", "kind": "widgets", "select": {"name": "Never"}, "fields": []}, "field": "count", "of": "count", "match": null, "op": ">=", "value": 1}},
    {"t": 2.5, "shot": "already", "when": {"query": {"id": "w_already", "kind": "widgets", "select": {"name": "Banner", "visible": false}, "fields": ["visible"]}, "field": "visible", "of": "any", "match": null, "op": ">=", "value": 1}}
  ],
  "queries": [
    {"id": "banner", "kind": "widgets", "select": {"name": "Banner"}, "fields": []},
    {"id": "score", "kind": "objects", "select": {"name": "Events"}, "fields": ["prop:score"]}
  ]
