{
  "seconds": 4,
  "shots": 0,
  "every": 0.1,
  "scene": "res://scenes/Events.tscn",
  "inputs": [
    {"t": 0.5, "shot": "lost", "when": {"query": {"id": "w_never", "kind": "widgets", "select": {"name": "Never"}, "fields": []}, "field": "count", "of": "count", "match": null, "op": ">=", "value": 1, "within": 1.0}},
    {"t": 1.0, "key": "<Keyboard>/space", "press": true},
    {"t": 1.0, "shot": "win", "when": {"query": {"id": "w_win", "kind": "widgets", "select": {"name": "Banner"}, "fields": []}, "field": "count", "of": "count", "match": null, "op": ">=", "value": 1, "within": 2.0}},
    {"t": 1.0, "shot": "five", "when": {"query": {"id": "w_five", "kind": "ui", "select": {"kind": "text"}, "fields": ["text"]}, "field": "text", "of": "count", "match": "^SCORE 5$", "op": ">=", "value": 1}},
