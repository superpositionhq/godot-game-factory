    {"id": "many", "kind": "objects", "select": {"tag": "many"}, "fields": ["x"]},
    {"id": "parts", "kind": "objects", "select": {"name": "Main"}, "fields": ["forward:Camera.y", "rel_yaw:Camera", "world_pitch:Camera3D", "world_yaw:Spinner"]},
    {"id": "ghost", "kind": "widgets", "select": {"name": "GhostButton", "visible": false}, "fields": ["text", "visible"]},
    {"id": "ghost_shown", "kind": "widgets", "select": {"name": "GhostButton"}, "fields": []},
