    {"id": "ball", "kind": "objects", "select": {"name": "Ball", "has": {"simulating": true}}, "fields": ["collision", "simulating"]},
    {"id": "made", "kind": "spawns", "component": "coin"},
    {"id": "cam", "kind": "camera", "fields": ["occluded", "player_on_screen"]},
    {"id": "lights", "kind": "components", "select": {"component": "Light3D"}, "fields": ["intensity", "on"]},
    {"id": "health", "kind": "widgets", "select": {"name": "Health"}, "fields": ["percent", "value", "visible", "w"]},
    {"id": "count", "kind": "widgets", "select": {"component": "Label", "name": "CountLabel"}, "fields": ["text"]},
    {"id": "button", "kind": "widgets", "select": {"component": "Button"}, "fields": ["h", "interactable", "text", "w", "x", "y"]},
    {"id": "secret", "kind": "widgets", "select": {"name": "SecretText", "visible": false}, "fields": ["visible"]},
    {"id": "texts", "kind": "ui", "select": {"kind": "text"}, "fields": ["h", "text", "w", "x", "y"]},
    {"id": "boxes", "kind": "ui", "select": {"kind": "box"}, "fields": []},
