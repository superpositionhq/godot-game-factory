; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="__TITLE__"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("__GODOT_FEATURE__", "Mobile")
config/icon="res://icon.svg"
config/quit_on_go_back=false

[autoload]

AutoPlay="*res://addons/autoplay/autoplay.gd"
Phone="*res://game/phone.gd"
Scenarios="*res://game/scenarios.gd"

[display]

window/size/viewport_width=__PHONE_WIDTH__
window/size/viewport_height=__PHONE_HEIGHT__
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=__HANDHELD__

[editor]

movie_writer/video_quality=0.9

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
