# Line endings: normalise text, leave binaries alone.
* text=auto

# Godot's own text files: plain git text with LF, as the engine writes them, so diffs stay small.
*.godot text eol=lf
*.cfg text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.import text eol=lf
*.uid text eol=lf
*.gdshader text eol=lf
*.gdshaderinc text eol=lf
# GDScript with LF in every checkout. (A step's sha256 in workflow.jsonl is taken of the file as committed, LF, so it
# holds whatever line endings the step had on disk when it ran.)
*.gd text eol=lf

# Every binary type goes through Git LFS (GitHub refuses files over 100 MB, and binary history bloats clones).
# Patterns are case-insensitive ([pP][nN][gG]) so FOO.PNG from a store pack is caught too.
# Add a type here BEFORE committing the first file of a new binary type (git lfs migrate rewrites history).

# Godot's binary resources and scenes, baked data and compressed textures
*.[rR][eE][sS] filter=lfs diff=lfs merge=lfs -text
*.[sS][cC][nN] filter=lfs diff=lfs merge=lfs -text
